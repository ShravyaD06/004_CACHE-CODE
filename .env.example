# =============================================================================
# DocuSense AI — CBC 2.0 Environment Configuration Template
# =============================================================================
# SAFETY INSTRUCTION:
# Copy this file to '.env' and populate with your own confidential credentials.
# NEVER commit the active '.env' file or expose private keys to source control.
# =============================================================================

# --- Backend Server Configuration ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Persistence ---
# Default SQLite local storage:
DATABASE_URL=sqlite:///./backend/docusense.db
# Production PostgreSQL migration path:
# DATABASE_URL=postgresql+psycopg2://docusense_user:password@localhost:5432/docusense_db

# --- Google Gemini AI API Configuration ---
# Optional: Required for multi-modal LLM structured extraction & Gemini Copilot.
# If omitted or empty, DocuSense AI automatically and gracefully falls back
# to the deterministic local layout/regex rule engine without service interruption.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# --- OCR Engine Configuration ---
# PyMuPDF is active for digital vector PDFs.
# OpenCV pipeline handles deskew, CLAHE contrast, and Laplacian sharpness analysis.
# PP-OCRv5 / PaddleOCR can be activated in Python 3.10/3.11 environments.
OCR_ENGINE=pymupdf_opencv
ENABLE_PADDLE_FALLBACK=false

# --- Security & Rate Limiting ---
SECRET_KEY=generate_a_secure_random_secret_key_here_for_jwt_session
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=25

# --- Enterprise Webhooks & External ERP Integrations (Optional) ---
SAP_WEBHOOK_URL=https://api.enterprise.corp/sap/invoices/v1
SALESFORCE_WEBHOOK_URL=https://api.salesforce.corp/kyc/v1
WORKDAY_WEBHOOK_URL=https://api.workday.corp/hr/v1
QUICKBOOKS_WEBHOOK_URL=https://api.quickbooks.corp/invoices/v1
